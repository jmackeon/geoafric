{
  "name": "geoafric",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev":         "turbo run dev",
    "dev:web":     "turbo run dev --filter=web --filter=api",
    "dev:mobile":  "turbo run dev --filter=mobile",
    "build":       "turbo run build",
    "lint":        "turbo run lint",
    "clean":       "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.9.8",
    "typescript": "^5.6.3"
  }
}